---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    src: ImageMetadata;
    alt: string;
    class?: string;
    loading?: "eager" | "lazy";
}

const { src, alt, class: className, loading = "lazy" } = Astro.props;
---

<figure class:list={["fullscreen-image", className]} data-fullscreen-image>
    <button
        class="fullscreen-image__trigger"
        type="button"
        aria-label={`Open ${alt} in full screen`}
        data-fullscreen-image-trigger
    >
        <Image src={src} alt={alt} loading={loading} />
    </button>

    <dialog class="fullscreen-image__dialog" aria-label={alt} data-fullscreen-image-dialog>
        <button
            class="fullscreen-image__close"
            type="button"
            aria-label="Close full-screen image"
            data-fullscreen-image-close
        >
            ×
        </button>
        <Image src={src} alt="" loading="eager" />
    </dialog>
</figure>

<script>
    document.querySelectorAll<HTMLElement>("[data-fullscreen-image]").forEach(
        (container) => {
            const trigger = container.querySelector<HTMLButtonElement>(
                "[data-fullscreen-image-trigger]",
            );
            const dialog = container.querySelector<HTMLDialogElement>(
                "[data-fullscreen-image-dialog]",
            );
            const closeButton = container.querySelector<HTMLButtonElement>(
                "[data-fullscreen-image-close]",
            );

            if (!trigger || !dialog || !closeButton) return;

            trigger.addEventListener("click", () => dialog.showModal());
            closeButton.addEventListener("click", () => dialog.close());
            dialog.addEventListener("click", (event) => {
                if (event.target === dialog) dialog.close();
            });
        },
    );
</script>

<style>
    .fullscreen-image {
        display: flex;
        justify-content: center;
        margin: 0;
    }

    .fullscreen-image__trigger {
        display: block;
        max-inline-size: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        cursor: zoom-in;
    }

    .fullscreen-image__trigger :global(img) {
        display: block;
        inline-size: 100%;
        block-size: auto;
    }

    .fullscreen-image__dialog {
        max-inline-size: 100vw;
        max-block-size: 100vh;
        margin: auto;
        padding: clamp(1rem, 3vw, 2rem);
        border: 0;
        background: transparent;
        cursor: zoom-out;
    }

    .fullscreen-image__dialog::backdrop {
        background: rgb(0 0 0 / 85%);
    }

    .fullscreen-image__dialog :global(img) {
        display: block;
        max-inline-size: calc(100vw - 2rem);
        max-block-size: calc(100vh - 2rem);
        inline-size: auto;
        block-size: auto;
        object-fit: contain;
    }

    .fullscreen-image__close {
        position: fixed;
        inset-block-start: 1rem;
        inset-inline-end: 1rem;
        display: grid;
        place-items: center;
        inline-size: 2.5rem;
        block-size: 2.5rem;
        padding: 0;
        border: 1px solid var(--secondary-color);
        border-radius: 50%;
        background: var(--background-color);
        color: var(--text-color);
        font-size: 1.75rem;
        line-height: 1;
        cursor: pointer;
    }
</style>
