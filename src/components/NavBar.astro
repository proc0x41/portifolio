<header>
    <nav>
        <a href="/" class="logo">Proc0x41</a>
        <ul>
            <li><a href="https://github.com/proc0x41">Projects</a></li>
            <li><a href="#contact">Contact</a></li>
            <!-- <li><a href="#contact">Blog</a></li> -->
        </ul>
    </nav>
</header>

<style>
    header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--background-color);
        opacity: 0.9;
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--secondary-color);
    }
    nav {
        /*display: flex;
        justify-content: space-between;
        padding: 1rem 4rem;
        background: var(--background-color);
        border-bottom: 1px solid gray;
        */
        max-width: 1024px;
        margin: 0 auto;
        padding: 0.4rem;
        display: flex;
        opacity: 1;
        justify-content: space-between;
        align-items: center;
    }

    ul {
        display: flex;
        list-style: none;
        gap: 0.5rem;
    }

    li {
        padding: 0px 0px 0px 20px;
    }

    .logo {
        color: var(--text-color);
    }

    a {
        color: var(--primary-color);
        text-decoration: none;
        position: relative;
        padding-bottom: 2px; /* espaço pra linha */
    }

    a::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -2px;
        height: 2px;
        border-radius: 999px;
        background: linear-gradient(
            90deg,
            var(--primary-color),
            var(--primary-color-hover)
        );
        transform: scaleX(0);
        transform-origin: left;
        transition:
            transform 220ms ease,
            opacity 220ms ease;
        opacity: 0.95;
    }

    a:hover::after,
    a:focus-visible::after {
        transform: scaleX(1);
    }

    a:hover,
    a:focus-visible {
        color: var(--primary-color-hover);
    }
</style>
